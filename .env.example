MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8002

# ---------------------------------------------------------------------------
# Credentials Vault Integration
# Generic vars that work with any HTTP-based secret manager (e.g. NetBox-
# Secrets, HashiCorp Vault, CyberArk Conjur, …).
# Only active when PYATS_TESTBED_PATH is NOT set (external inventory mode).
# ---------------------------------------------------------------------------
# API bearer token (plain string)
CREDENTIALS_VAULT_TOKEN=your_netbox_token_here
# Path to the RSA/EC private key file used to obtain a decryption session key
CREDENTIALS_VAULT_PRIVATE_KEY_PATH=private.key
# NetBox base URL (no trailing slash). Use host.docker.internal when NetBox runs on the host machine.
CREDENTIALS_VAULT_BASE_URL=http://host.docker.internal:8000
# netbox-secrets role slug whose plaintext value is the device username
CREDENTIALS_VAULT_USERNAME_ROLE=username
# netbox-secrets role slug whose plaintext value is the device password
CREDENTIALS_VAULT_PASSWORD_ROLE=password
# Credential cache TTL in seconds (defaults to PYATS_MCP_TESTBED_CACHE_TTL)
#CREDENTIALS_VAULT_CACHE_TTL=30
# Set to 0 to disable TLS cert verification (lab only, not recommended)
#CREDENTIALS_VAULT_VERIFY_SSL=1